# Lesser — Firebase / Gemini Configuration
# Copy this file to lesser/.env and fill in your values.
# Variables must be prefixed with EXPO_PUBLIC_ to be accessible in the app bundle.
# Never commit .env to git!

EXPO_PUBLIC_FIREBASE_API_KEY=...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=...
EXPO_PUBLIC_FIREBASE_PROJECT_ID=...
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=...
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
EXPO_PUBLIC_FIREBASE_APP_ID=...
EXPO_PUBLIC_FIREBASE_DATABASE_URL=...

# Optional: mensajes motivacionales con Gemini
EXPO_PUBLIC_GEMINI_API_KEY=...
